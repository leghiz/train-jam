    - target: {fileID: 6937784398985170736, guid: 92bbb8ca974672848b07cca21d2d0719, type: 3}
      propertyPath: text
      value: "\u041A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0441\u0442\u0430\u0432 \u0431\u044B\u043B \u0433\u043E\u0442\u043E\u0432 \u043A \u0432\u044B\u0445\u043E\u0434\u0443 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0432\u0441\u0451, \u0447\u0442\u043E \u0435\u0441\u0442\u044C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439: \u0448\u043F\u0430\u043B\u044B, \u043B\u0438\u0441\u0442\u043E\u0432\u043E\u0435 \u0436\u0435\u043B\u0435\u0437\u043E, \u0441\u0442\u0430\u0440\u044B\u0435 \u0440\u0435\u043B\u044C\u0441\u044B \u0438 \u043F\u0435\u0441\u043E\u043A. \u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C, \u0447\u0442\u043E \u0438\u0437 \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C \u043D\u0430 \u043A\u043E\u043B\u0451\u0441\u0430\u0445? \u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u0438 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u0431\u0440\u043E\u043D\u0435\u043F\u043E\u0435\u0437\u0434 \u0432\u0441\u0435\u0433\u043E \u0437\u0430 \u0441\u0443\u0442\u043A\u0438. \u0412\u043E\u0442 \u044D\u0442\u043E \u0431\u044B\u043B\u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430!"
      objectReference: {fileID: 0}
    - target: {fileID: 6937784398985170736, guid: 92bbb8ca974672848b07cca21d2d0719, type: 3}
