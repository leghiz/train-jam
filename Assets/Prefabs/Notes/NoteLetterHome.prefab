    - target: {fileID: 6937784398985170736, guid: 92bbb8ca974672848b07cca21d2d0719, type: 3}
      propertyPath: text
      value: "\u041C\u044B \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0434\u0432\u0438\u0436\u0435\u043C\u0441\u044F \u0432\u0434\u043E\u043B\u044C \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438. \u0418\u043D\u043E\u0433\u0434\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u044D\u0442\u0438\u0445 \u0432\u0430\u0433\u043E\u043D\u043E\u0432 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u044B\u043C, \u0433\u0440\u043E\u0445\u043E\u0442 \u043A\u043E\u043B\u0451\u0441 \u0438 \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u044F \u0443\u0436\u0435 \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E.\n\n\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u043D\u043E\u0432\u0430 \u043A\u0440\u0430\u0441\u043D\u044B\u0435. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u043F\u043E\u0434\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043A \u0441\u043E\u0441\u0442\u0430\u0432\u0443.\n\n\u0415\u0441\u043B\u0438 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u0435\u0440\u043D\u0443\u0441\u044C, \u0445\u043E\u0447\u0443 \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430\u0448 \u0434\u043E\u043C. \u0418 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0441\u0432\u0438\u0441\u0442\u043A\u0430 \u043F\u0430\u0440\u043E\u0432\u043E\u0437\u0430."
      objectReference: {fileID: 0}
